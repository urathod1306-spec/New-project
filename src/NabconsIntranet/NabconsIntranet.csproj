<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NabconsIntranet</RootNamespace>
    <AssemblyName>NabconsIntranet</AssemblyName>
    <Version>1.4.0</Version>
    <Product>NABCONS Intranet</Product>
    <Company>NABARD Consultancy Services</Company>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Never phone home: no telemetry, no update checks at runtime. -->
    <UseAppHost>true</UseAppHost>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Release package for Windows: one self-contained .exe, no .NET install needed on the office PC.
       The SQLite native DLL is kept next to the .exe (not extracted to %TEMP%) so application
       allow-listing (AppLocker / WDAC) can approve the whole folder. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Bundle the latest patched .NET runtime (security fixes), whatever SDK patch builds the package. -->
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <KnownFrameworkReference Update="Microsoft.AspNetCore.App" LatestRuntimeFrameworkVersion="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions are pinned deliberately (software bill of materials: docs/SBOM.md). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
    <!-- e-Note PDF: correct shaping of Hindi (Devanagari) and English text. MIT, offline. -->
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.153.1" />
    <PackageReference Include="HarfBuzzSharp" Version="14.2.1.301" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.2.1.301" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.301" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fonts for the e-Note PDF (SIL Open Font License 1.1, see Resources/Fonts/OFL.txt), embedded in the program
         and in each PDF, so nothing depends on fonts installed on the server. -->
    <EmbeddedResource Include="Resources/Fonts/*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
