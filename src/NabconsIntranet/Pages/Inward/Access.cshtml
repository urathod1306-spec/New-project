@page
@model NabconsIntranet.Pages.Inward.AccessModel
@{
    ViewData["Title"] = "Inward access";
    var accounts = Model.Members.Count(m => m.Role == InwardRole.Accounts && m.IsActive);
}
<div class="page-head"><div><h1>Inward access</h1><p>Who runs the registry of each office, who sees every item, and who records invoice payments. You cannot change your own access.</p></div></div>
<partial name="_InwardTabs" />
@if (Model.NoOperator.Count > 0) { <div class="alert warning">No active Inward Operator for: @string.Join(", ", Model.NoOperator).</div> }
@if (accounts == 0) { <div class="alert warning">No active Invoice Accounts user: certified invoices will wait in the Accounts queue with nobody to pay them.</div> }
<div class="grid two">
    <div class="card table-wrap">
        <h2>Current access</h2>
        @if (Model.Members.Count == 0) { <p class="empty">No grants yet.</p> }
        else
        {
            <table class="table compact">
                <thead><tr><th>User</th><th>Role</th><th>Office</th><th>Granted</th><th></th></tr></thead>
                @foreach (var m in Model.Members)
                {
                    <tr class="@(m.IsActive ? "" : "muted")"><td>@m.DisplayName <span class="small muted">@m.Username</span>@if (!m.IsActive) { <span class="badge danger">inactive</span> }</td>
                        <td>@InwardRole.Labels.GetValueOrDefault(m.Role, m.Role)</td><td>@m.OfficeName</td><td class="small">@m.GrantedByName, @F.DateDot(m.GrantedAt)</td>
                        <td>@if (m.UserId != User.UserId()) { <form method="post" asp-page-handler="Revoke"><input type="hidden" name="memberId" value="@m.Id" /><button class="btn sm" type="submit">Remove</button></form> }</td></tr>
                }
            </table>
        }
    </div>
    <form method="post" asp-page-handler="Grant" class="card">
        <h2>Grant access</h2>
        <div class="field"><label for="gu">User *</label><select id="gu" name="userId" required><option value="">Choose…</option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.DisplayName (@u.Username)</option> }</select></div>
        <div class="field"><label for="gr">Role *</label><select id="gr" name="role" data-switch="role" required>@foreach (var r in InwardRole.Labels) { <option value="@r.Key">@r.Value</option> }</select></div>
        <div class="field" data-when-role="InwardOperator"><label for="go">Office (for an Inward Operator)</label><select id="go" name="officeId">@foreach (var o in Model.Offices) { <option value="@o.Id">@o.Name (@o.NumberCode)</option> }</select></div>
        <button class="btn primary" type="submit">Grant</button>
        <p class="small muted mt">Offices and their inward codes are kept on Administration → Master lists → Offices / Locations.</p>
    </form>
</div>
<div class="card table-wrap mt">
    <h2>History (latest 100)</h2>
    <table class="table compact">
        <thead><tr><th>When</th><th>User</th><th>Change</th><th>Role</th><th>By</th></tr></thead>
        @foreach (var h in Model.History) { <tr><td class="nowrap">@F.DateTime(h.At)</td><td>@h.DisplayName</td><td>@h.Action</td><td>@InwardRole.Labels.GetValueOrDefault(h.Role ?? "", h.Role ?? "")@(h.OfficeId > 0 ? $" (office #{h.OfficeId})" : "")</td><td>@h.ActorName</td></tr> }
    </table>
</div>
