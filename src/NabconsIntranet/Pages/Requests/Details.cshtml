@page "{id:long}"
@model NabconsIntranet.Pages.Requests.DetailsModel
@{
    var r = Model.Item;
    ViewData["Title"] = r.RequestNumber;
    var flow = new[] { RequestStates.Draft, RequestStates.Submitted, RequestStates.UnderReview, "Decision", RequestStates.Closed };
    int pos = r.State switch
    {
        RequestStates.Draft or RequestStates.Returned => 0,
        RequestStates.Submitted => 1,
        RequestStates.UnderReview => 2,
        RequestStates.Approved or RequestStates.Rejected => 3,
        _ => 4,
    };
    var decision = r.State is RequestStates.Approved or RequestStates.Rejected ? r.State
        : r.State == RequestStates.Closed ? (Model.History.LastOrDefault(h => h.ToState is RequestStates.Approved or RequestStates.Rejected)?.ToState ?? "Decision") : "Approved / Rejected";
}
<div class="page-head">
    <div>
        <p class="muted"><a href="/Requests">← My requests</a> @if (User.IsApprover()) { <span>· <a href="/Requests/Inbox">Approval inbox</a></span> }</p>
        <h1>@r.Subject</h1>
        <p>@r.RequestNumber · <span class="badge @r.State">@r.State</span> · @RequestWorkflow.FormName</p>
    </div>
    <div class="actions">
        @if (Model.CanEdit) { <a class="btn" href="/Requests/Edit/@r.Id">Edit</a> }
        <button class="btn" type="button" data-print>Print</button>
    </div>
</div>

<div class="card">
    <div class="steps">
        @for (int i = 0; i < flow.Length; i++)
        {
            var label = i == 3 ? decision : flow[i];
            var cls = i < pos ? "done" : i == pos ? "current" : "";
            if (i == 3 && (r.State == RequestStates.Rejected || label == RequestStates.Rejected)) { cls += " bad"; }
            if (i == 0 && r.State == RequestStates.Returned) { label = "Returned"; }
            <div class="step @cls">@label</div>
        }
    </div>
    <dl class="meta-grid">
        <dt>Submitted by</dt><dd>@r.SubmitterName @(string.IsNullOrEmpty(r.SubmitterVertical) ? "" : $"({r.SubmitterVertical})")</dd>
        <dt>Category</dt><dd>@r.RequestCategory</dd>
        <dt>Amount</dt><dd>@(r.Amount.HasValue ? Fmt.Money(r.Amount) : "—")</dd>
        <dt>Required by</dt><dd>@(string.IsNullOrEmpty(r.RequiredBy) ? "—" : F.Date(r.RequiredBy))</dd>
        <dt>Reviewing Officer</dt><dd>@r.ReviewerName</dd>
        <dt>Sanctioning Authority</dt><dd>@r.ApproverName</dd>
        <dt>Currently with</dt><dd>@(r.State is RequestStates.Submitted or RequestStates.UnderReview or RequestStates.Returned or RequestStates.Draft ? r.AssignedToName : "—")</dd>
        <dt>Created / updated</dt><dd>@F.DateTime(r.CreatedAt) / @F.DateTime(r.UpdatedAt)</dd>
    </dl>
    <h3 class="mt">Details and justification</h3>
    <p class="pre">@r.Details</p>
</div>

<div class="grid two mt">
    <div class="stack">
        <div class="card">
            <h2>Approval history</h2>
            <p class="muted small">Recorded permanently; entries cannot be edited or deleted.</p>
            <ol class="timeline">
                @foreach (var h in Model.History)
                {
                    <li>
                        <strong>@h.Action</strong> — @h.ActorName <span class="muted">(@h.ActorRole)</span>
                        <div class="when">@F.DateTime(h.Timestamp) · @(h.FromState ?? "—") → @h.ToState</div>
                        @if (!string.IsNullOrEmpty(h.Remarks)) { <div class="remarks">@h.Remarks</div> }
                    </li>
                }
            </ol>
        </div>
        <div class="card">
            <h2>Attachments</h2>
            @if (Model.Attachments.Count == 0) { <p class="empty">No attachments.</p> }
            <ul class="list">
                @foreach (var a in Model.Attachments)
                {
                    <li>
                        <a href="/Requests/Attachment/@a.Id">@a.OriginalFileName</a> <span class="muted small">@Fmt.Size(a.SizeBytes)</span>
                        <div class="meta">Uploaded by @a.UploadedBy, @F.DateTime(a.UploadedAt) · SHA-256 <span class="mono">@a.Sha256</span></div>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div>
        @if (Model.Actions.Count > 0)
        {
            <form method="post" class="card" asp-route-id="@r.Id">
                <h2>Take action</h2>
                <input type="hidden" name="rowVersion" value="@r.RowVersion" />
                <div class="field">
                    <label for="remarks">Remarks @(Model.Actions.Any(a => a.RemarksRequired) ? "(required to return or reject)" : "(optional)")</label>
                    <textarea id="remarks" name="remarks" maxlength="2000"></textarea>
                </div>
                <div class="checks">
                    @foreach (var a in Model.Actions)
                    {
                        <button class="btn @a.Style block" type="submit" name="wfAction" value="@a.Name" data-confirm="@a.Label — are you sure?">@a.Label</button>
                    }
                </div>
            </form>
        }
        else
        {
            <div class="card">
                <h2>Status</h2>
                <p class="muted">@(r.State switch
                {
                    RequestStates.Closed => "This request is closed.",
                    RequestStates.Submitted => $"Waiting for the Reviewing Officer ({r.ReviewerName}).",
                    RequestStates.UnderReview => $"Waiting for the Sanctioning Authority ({r.ApproverName}).",
                    RequestStates.Draft => "Draft — not yet submitted.",
                    RequestStates.Returned => "Returned to the submitter for clarification.",
                    _ => $"Decision recorded: {r.State}.",
                })</p>
            </div>
        }
    </div>
</div>
