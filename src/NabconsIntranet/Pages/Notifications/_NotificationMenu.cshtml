@model List<Notification>
@if (Model.Count == 0)
{
    <p class="muted small pad">You have no notifications yet.</p>
}
else
{
    <ul class="nlist">
        @foreach (var n in Model)
        {
            <li><a class="nitem @(n.IsRead ? "" : "unread")" href="/Notifications/Open/@n.Id">
                <span class="ntitle">@n.Title</span>
                <span class="nmeta">@(n.ActorName != null ? n.ActorName + " · " : "")<span title="@F.DateTime(n.CreatedAt)">@F.Relative(n.CreatedAt)</span>@(n.IsRead ? "" : " · unread")</span>
            </a></li>
        }
    </ul>
}
