@page
@model NabconsIntranet.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}
<div class="login-wrap">
    <div class="card">
        <h1>Change password</h1>
        @if (Model.Forced)
        {
            <div class="alert warning">You must choose a new password before continuing.</div>
        }
        <p class="muted small">At least 10 characters, with upper-case, lower-case, a number and a symbol.</p>
        <form method="post">
            <partial name="_Errors" />
            <div class="field">
                <label asp-for="CurrentPassword">Current password</label>
                <input asp-for="CurrentPassword" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword"></span>
            </div>
            <div class="field">
                <label asp-for="NewPassword">New password</label>
                <input asp-for="NewPassword" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword">Confirm new password</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
            <button class="btn primary block" type="submit">Change password</button>
        </form>
    </div>
</div>
