@page
@model NabconsIntranet.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="login-wrap">
    <div class="card">
        <div class="login-title">
            <img class="login-logo" src="~/img/nabcons-logo.png" alt="NABCONS logo" width="150" height="150" />
            <h1>@Site.SiteTitle</h1>
            <p>@Site.OrganisationName</p>
        </div>
        <p class="muted">Sign in to continue. @Site.Tagline</p>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <partial name="_Errors" />
            <div class="field">
                <label asp-for="Username">User name</label>
                <input asp-for="Username" autocomplete="username" autofocus />
                <span asp-validation-for="Username"></span>
            </div>
            <div class="field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <button class="btn primary block" type="submit">Sign in</button>
        </form>
        <p class="muted small mt">Forgotten your password? Contact the intranet administrator for a reset.</p>
    </div>
    @if (Site.ShowDemoAccountsOnLogin && Site.SeedDemoData)
    {
        <div class="card demo mt">
            <h3>Pilot demonstration accounts</h3>
            <p class="muted">All use the password <strong class="mono">@Seeder.DemoPassword</strong>. Turn this box off (<span class="mono">ShowDemoAccountsOnLogin</span>) before real use.</p>
            <table>
                @foreach (var d in Seeder.DemoUsers)
                {
                    <tr><td class="mono">@d.user</td><td>@d.note</td></tr>
                }
            </table>
        </div>
    }
</div>
