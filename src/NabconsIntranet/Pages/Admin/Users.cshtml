@page
@model NabconsIntranet.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users & roles";
}
<div class="page-head">
    <div>
        <p class="muted"><a href="/Admin">← Administration</a></p>
        <h1>Users &amp; roles</h1>
        <p>@(Site.IsWindowsAuth ? "Windows mode: users appear here automatically after their first sign-in. Assign roles below." : "Local accounts. Passwords are stored as salted PBKDF2 hashes.")</p>
    </div>
    <div class="actions"><a class="btn primary" href="/Admin/UserEdit">+ Add user</a></div>
</div>
<div class="card">
    <h3>Roles</h3>
    <ul class="list">
        @foreach (var r in Roles.Descriptions) { <li><strong>@r.Key</strong> — <span class="muted">@r.Value</span></li> }
    </ul>
</div>
<div class="card table-wrap mt">
    <table class="table">
        <thead><tr><th>User</th><th>Vertical</th><th>Roles</th><th>Status</th><th>Last sign-in</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model.Items)
            {
                <tr>
                    <td><strong>@u.DisplayName</strong><div class="muted small mono">@u.Username</div></td>
                    <td>@u.Vertical</td>
                    <td><div class="chips">@foreach (var r in u.RoleList) { <span class="chip">@r</span> }</div></td>
                    <td>
                        @if (!u.IsActive) { <span class="badge danger">Deactivated</span> }
                        else if (u.IsLockedOut) { <span class="badge warning">Locked</span> }
                        else { <span class="badge success">Active</span> }
                        @if (u.MustChangePassword) { <div class="muted small">Must change password</div> }
                    </td>
                    <td class="nowrap">@(u.LastLoginAt == null ? "—" : F.DateTime(u.LastLoginAt))</td>
                    <td><a class="btn sm" href="/Admin/UserEdit/@u.Id">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
