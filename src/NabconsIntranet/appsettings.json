{
  "Urls": "http://0.0.0.0:8080",

  "Intranet": {
    "OrganisationName": "NABARD Consultancy Services",
    "ShortName": "NABCONS",
    "SiteTitle": "NABCONS Intranet",
    "Tagline": "Internal portal for NABCONS staff - NABARD LAN only",
    "FooterText": "For official use within the NABARD LAN only. Do not upload personal, payroll or appraisal data.",

    "AuthenticationMode": "Local",
    "InitialAdminPassword": "Admin@12345",
    "WindowsAdministrators": [ ],
    "WindowsGroupRoles": { },
    "WindowsAutoProvisionStaff": true,

    "SeedDemoData": true,
    "ShowDemoAccountsOnLogin": true,

    "DataFolder": "data",
    "DocumentsFolder": "documents",
    "BackupFolder": "backups",
    "LogFolder": "logs",
    "SecondaryBackupFolder": "",

    "DailyBackupTime": "19:30",
    "BackupRetentionDays": 30,

    "MaxUploadMB": 20,
    "AllowedUploadExtensions": [ ".pdf", ".docx", ".xlsx", ".pptx", ".doc", ".xls", ".txt", ".csv", ".png", ".jpg", ".jpeg" ],

    "DisplayUtcOffsetMinutes": 330,
    "SessionTimeoutMinutes": 30,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": { "Default": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
